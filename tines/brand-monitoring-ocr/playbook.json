    {
      "type": "Agents::EventTransformationAgent",
      "name": "Event Transform",
      "disabled": false,
      "description": null,
      "guid": "9f980bd63dab81f3c29ca6e7908bb17e",
      "options": {
        "mode": "message_only",
        "loop": false,
        "payload": {
          "brandContext": {
            "brandName": "ABC Ltd",
            "officialDomains": [
              "abc.com",
              "www.abc.com"
            ],
            "brandAliases": [
              "ABC",
              "ABC Ltd",
              "ABC Limited",
              "ABC Investments"
            ],
            "expectedLogoNames": [
              "ABC Ltd",
              "ABC"
            ],
            "executiveNames": [
              "[ABC Ltd Chief Executive Officer]",
              "[ABC Ltd Chief Investment Officer]",
              "[ABC Ltd Chief Financial Officer]",
              "[ABC Ltd Head of Investments]",
              "[ABC Ltd Head of Client Services]"
            ],
            "suspiciousDomainTerms": [
              "abc-login",
              "abc-verify",
              "abc-support",
              "abc-secure",
              "abc-investment"
            ],
            "highRiskPhrases": [
              "verify your account",
              "confirm your identity",
              "account suspended",
              "password",
              "one-time passcode",
              "verification code",
              "wire transfer",
              "send money",
              "cryptocurrency",
              "crypto",
              "gift card",
              "guaranteed returns",
              "risk-free investment",
              "urgent action",
              "remote access",
              "WhatsApp",
              "Telegram"
            ]
          },
          "visionEvidence": {
            "submittedUrl": "=webhook.body.url",
            "ocrText": "=TRUNCATE(GET(FIRST(analyze_image_with_google_cloud_vision.body.responses), \"fullTextAnnotation.text\"), 4000, \"\")",
            "detectedLogos": "=SLICE_ARRAY(GET(FIRST(analyze_image_with_google_cloud_vision.body.responses), \"logoAnnotations\"), 0, 5)",
            "webEntities": "=SLICE_ARRAY(GET(FIRST(analyze_image_with_google_cloud_vision.body.responses), \"webDetection.webEntities\"), 0, 10)",
            "bestGuessLabels": "=GET(FIRST(analyze_image_with_google_cloud_vision.body.responses), \"webDetection.bestGuessLabels\")"
          },
          "domainReputation": {
            "checkedHost": "=PARSE_URL(webhook.body.url).host",
            "reputationScore": "=GET(get_domain_reputation_virus_total.body, \"data.attributes.reputation\")",
            "vendorStats": "=GET(get_domain_reputation_virus_total.body, \"data.attributes.last_analysis_stats\")",
            "categories": "=GET(get_domain_reputation_virus_total.body, \"data.attributes.categories\")",
            "creationDate": "=GET(get_domain_reputation_virus_total.body, \"data.attributes.creation_date\")",
            "lastAnalysisDate": "=GET(get_domain_reputation_virus_total.body, \"data.attributes.last_analysis_date\")"
          }
        }
      },
