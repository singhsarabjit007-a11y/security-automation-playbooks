    {
      "type": "Agents::LLMAgent",
      "name": "AI Agent",
      "disabled": false,
      "description": null,
      "guid": "1f26d235c6f9863f183f99d5fbba23c0",
      "options": {
        "mode": "task",
        "code_analyst_enabled": false,
        "web_search_enabled": false,
        "instructions": "You are a brand-protection analyst for ABC Ltd.\n\nOfficial domains: abc.com, www.abc.com.\nBrand names: ABC, ABC Ltd, ABC Limited, ABC Investments.\nExpected logo names: ABC Ltd, ABC.\n\nLeadership-name placeholders: [ABC Ltd Chief Executive Officer], [ABC Ltd Chief Investment Officer], [ABC Ltd Chief Financial Officer], [ABC Ltd Head of Investments], [ABC Ltd Head of Client Services].\n\nHigh-risk wording includes: verify your account, account suspended, password, one-time passcode, verification code, wire transfer, cryptocurrency, crypto, gift card, guaranteed returns, remote access, WhatsApp, Telegram.\n\nCompare the supplied compact Google Vision evidence against this context. A logo or name match alone does not prove abuse. Return valid JSON only.",
        "prompt": "BRAND CONTEXT:\n<<event_transform.brandContext>>\n\nCOMPACT GOOGLE VISION EVIDENCE:\n<<event_transform.visionEvidence>>\n\nCompare the evidence with the brand context.\n\nReturn exactly this JSON:\n\n{\n  \"ocr_matches\": [],\n  \"ocr_match_percent\": 0,\n  \"ocr_why\": \"\",\n  \"logo_matches\": [],\n  \"logo_match_percent\": 0,\n  \"logo_why\": \"\",\n  \"domain_assessment\": \"official | non_official | lookalike | unknown\",\n  \"domain_risk_percent\": 0,\n  \"domain_why\": \"\",\n  \"high_risk_matches\": [],\n  \"verdict\": \"legitimate | false_positive | suspicious | likely_impersonation | inconclusive\",\n  \"why\": \"\"\n}"
      },
      "reporting": {
        "time_saved_value": 0,
        "time_saved_unit": "minutes"
      },
      "monitoring": {
        "monitor_all_events": false,
        "monitor_failures": false,
