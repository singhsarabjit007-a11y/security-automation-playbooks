  "diagram_notes": [
    {
      "content": "Already tested\n",
      "position": [
        1050,
        840
      ],
      "guid": "41fda442b4a5473ceebc156be387b9c9",
      "width": 290
    },
    {
      "content": "Testing with multiple OSINT sources\\\nEnriches each public IP using VirusTotal, AbuseIPDB, APIVoid, and IP2Location.\n",
      "position": [
        240,
        750
      ],
      "guid": "37d947708b5c7e407ff0caef51df0cfa",
      "width": 290
    },
    {
      "content": "curl -X POST \"https\\://<your-tines-tenant>.tines.com/webhook/ip-enrichment/222\" -H \"Content-Type: application/json\" -d \"{\"ips\":\\[\"8.8.8.8\"]}\"\n",
      "position": [
        990,
        45
      ],
      "guid": "cb3e356bc085fdfe523a84079d1550f1",
      "width": 371
    },
    {
      "content": "Validates and normalizes incoming IPv4 addresses, then continues only with public IPs.\n",
      "position": [
        990,
        210
      ],
      "guid": "5df00b6bbedb0cb95607758c9d336790",
      "width": 290
    },
    {
      "content": "**DISCLAIMER**\\\nThe story is not production ready. This was created to test OSINT sources and incorporate AI agent for end summary. This will help an SOC analyst to make informed decision based on quick summary\n",
      "position": [
        315,
        -75
      ],
      "guid": "5eeaf49d5b6730fed353be26cd000c7b",
      "width": 960
    }
  ],
