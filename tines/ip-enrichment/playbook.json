    {
      "type": "Agents::RunScriptAgent",
      "name": "Run Script",
      "disabled": false,
      "description": null,
      "guid": "bcb1c5efdf4be0662db84d3d4cf2ff0e",
      "options": {
        "language": "python_3_13",
        "script": "def parse_json_string_array(value):\n    if not isinstance(value, str):\n        return None\n\n    index = 0\n    length = len(value)\n\n    def skip_whitespace(position):\n        while position < length and value[position] in \" \\t\\r\\n\":\n            position += 1\n        return position\n\n    index = skip_whitespace(index)\n\n    if index >= length or value[index] != \"[\":\n        return None\n\n    index += 1\n    result = []\n\n    while True:\n        index = skip_whitespace(index)\n\n        if index < length and value[index] == \"]\":\n            index += 1\n            return result if skip_whitespace(index) == length else None\n\n        if index >= length or value[index] != '\"':\n            return None\n\n        index += 1\n        item = \"\"\n\n        while index < length:\n            char = value[index]\n            index += 1\n\n            if char == '\"':\n                break\n\n            if char == \"\\\\\":\n                if index >= length:\n                    return None\n\n                escaped = value[index]\n                index += 1\n\n                escapes = {\n                    '\"': '\"',\n                    \"\\\\\": \"\\\\\",\n                    \"/\": \"/\",\n                    \"b\": \"\\b\",\n                    \"f\": \"\\f\",\n                    \"n\": \"\\n\",\n                    \"r\": \"\\r\",\n                    \"t\": \"\\t\"\n                }\n\n                if escaped not in escapes:\n                    return None\n\n                item += escapes[escaped]\n            else:\n                item += char\n        else:\n            return None\n\n        result.append(item)\n        index = skip_whitespace(index)\n\n        if index < length and value[index] == \",\":\n            index += 1\n        elif index < length and value[index] == \"]\":\n            index += 1\n            return result if skip_whitespace(index) == length else None\n        else:\n            return None\n\n\ndef parse_ipv4(value):\n    parts = value.split(\".\")\n\n    if len(parts) != 4:\n        return None\n\n    numbers = []\n\n    for part in parts:\n        if not part or any(char not in \"0123456789\" for char in part):\n            return None\n\n        if len(part) > 1 and part[0] == \"0\":\n            return None\n\n        number = int(part)\n\n        if number > 255:\n            return None\n\n        numbers.append(number)\n\n    return numbers, \".\".join(str(number) for number in numbers)\n\n\ndef ipv4_is_public(numbers):\n    ip_number = (\n        (numbers[0] << 24)\n        + (numbers[1] << 16)\n        + (numbers[2] << 8)\n        + numbers[3]\n    )\n\n    non_public_ranges = [\n        (0x00000000, 0x00FFFFFF),  # 0.0.0.0/8\n        (0x0A000000, 0x0AFFFFFF),  # 10.0.0.0/8\n        (0x64400000, 0x647FFFFF),  # 100.64.0.0/10\n        (0x7F000000, 0x7FFFFFFF),  # 127.0.0.0/8\n        (0xA9FE0000, 0xA9FEFFFF),  # 169.254.0.0/16\n        (0xAC100000, 0xAC1FFFFF),  # 172.16.0.0/12\n        (0xC0A80000, 0xC0A8FFFF),  # 192.168.0.0/16\n        (0xE0000000, 0xFFFFFFFF)   # Multicast/reserved\n    ]\n\n    return not any(\n        start <= ip_number <= end\n        for start, end in non_public_ranges\n    )\n\n\ndef inspect_ip(raw_ip, attribute_id):\n    result = {\n        \"attribute_id\": attribute_id,\n        \"original_ip\": raw_ip,\n        \"normalized_ip\": None,\n        \"ip_is_public\": False,\n        \"ip_is_valid\": False\n    }\n\n    # No trimming, replacement, or sanitization occurs.\n    # Values such as \"8.8.8.8}\" remain invalid.\n    if not isinstance(raw_ip, str):\n        return result\n\n    parsed = parse_ipv4(raw_ip)\n\n    if parsed is None:\n        return result\n\n    numbers, normalized_ip = parsed\n\n    result[\"normalized_ip\"] = normalized_ip\n    result[\"ip_is_public\"] = ipv4_is_public(numbers)\n    result[\"ip_is_valid\"] = True\n\n    return result\n\n\ndef main(input):\n    raw_ips = input.get(\"ips\", [])\n\n    ips = (\n        raw_ips\n        if isinstance(raw_ips, list)\n        else parse_json_string_array(raw_ips)\n    )\n\n    if ips is None:\n        ips = [raw_ips]\n\n    valid_ips = []\n\n    for index, ip in enumerate(ips):\n        ip_result = inspect_ip(ip, index + 1)\n\n        if ip_result[\"ip_is_valid\"]:\n            valid_ips.append(ip_result)\n\n    return {\n        \"ips\": valid_ips\n    }",
        "requirements": "requests==2.34.2",
        "input": {
          "ips": "<<webhook.body.ips>>"
        },
        "timeout": "10",
        "emit_failure_event": true
