    {
      "type": "Agents::HTTPRequestAgent",
      "name": "Submit a URL to be scanned",
      "disabled": false,
      "description": "The submission API allows you to submit a URL to be scanned and set some options for the scan. The response will return a unique scan UUID. With the unique UUID you can retrieve the scan result, screenshot and DOM snapshot after waiting for a while. \n\nLink to documentation: https://urlscan.io/docs/api/",
      "guid": "ba3b1a86b7eb78f313bcd37ec0c60be7",
      "options": {
        "url": "https://urlscan.io/api/v1/scan/",
        "content_type": "application_json",
        "method": "post",
        "headers": {
          "API-KEY": "<<INPUT.urlscan_credential>>"
        },
        "payload": "=LOCAL.final_payload",
        "local": {
          "optional_parameters": {
            "url": "=explode_urls.url.url",
            "visibility": "=FORCE_ARRAY(INPUT.visibility)[0]",
            "tags": "=SPLIT(REMOVE(INPUT.tags, \" \"), \",\")",
            "customagent": "=INPUT.custom_agent",
            "referer": "=INPUT.referer",
            "overrideSafety": "=IF(INPUT.override_safety = TRUE, \"yes\", NULL)",
            "country": "=INPUT.country"
          },
          "final_payload": "=REJECT(\n  LOCAL.optional_parameters,\n  LAMBDA(\n    item,\n    OR(\n      item = NULL,\n      IF(\n        OR(\n          TYPE(item) = \"TrueClass\",\n          TYPE(item) = \"FalseClass\",\n          TYPE(item) = \"Integer\"\n        ),\n        IS_EMPTY(TEXT(item)),\n        IS_EMPTY(item)\n      )\n    )\n  )\n)"
        }
