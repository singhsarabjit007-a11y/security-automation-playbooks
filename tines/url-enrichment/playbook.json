    {
      "type": "Agents::RunScriptAgent",
      "name": "Normalize URLs",
      "disabled": false,
      "description": null,
      "guid": "094fb12811aa60425a12ffa30040d044",
      "options": {
        "language": "python_3_13",
        "script": "def main(input):\n    raw_urls = input[\"urls\"]\n\n    # Turn the received stringified array into a list.\n    if isinstance(raw_urls, str):\n        text = raw_urls.strip()\n\n        if text.startswith(\"[\") and text.endswith(\"]\"):\n            text = text[1:-1].strip()\n\n        if text:\n            urls = text.split('\",\"')\n            urls = [url.strip().strip('\"').strip(\"'\") for url in urls]\n        else:\n            urls = []\n    else:\n        urls = raw_urls\n\n    valid_urls = []\n    url_number = 1\n\n    for original_url in urls:\n        normalized_url = str(original_url).strip()\n\n        normalized_url = normalized_url.replace(\"[.]\", \".\")\n        normalized_url = normalized_url.replace(\"(.)\", \".\")\n        normalized_url = normalized_url.replace(\"{.}\", \".\")\n        normalized_url = normalized_url.replace(\"<.>\", \".\")\n        normalized_url = normalized_url.replace(\"[dot]\", \".\")\n\n        normalized_url = normalized_url.replace(\"[:]\", \":\")\n        normalized_url = normalized_url.replace(\"(:)\", \":\")\n        normalized_url = normalized_url.replace(\"{:}\", \":\")\n\n        normalized_url = normalized_url.replace(\"/[/]\", \"//\")\n        normalized_url = normalized_url.replace(\"[/]\", \"/\")\n\n        lower_url = normalized_url.lower()\n\n        if lower_url.startswith(\"hxxps://\"):\n            normalized_url = \"https://\" + normalized_url[8:]\n        elif lower_url.startswith(\"hxxp://\"):\n            normalized_url = \"http://\" + normalized_url[7:]\n\n        # Treat bare domains, including www.example.com, as HTTPS URLs.\n        if normalized_url and \" \" not in normalized_url and \"://\" not in normalized_url:\n            normalized_url = \"https://\" + normalized_url\n\n        is_valid = False\n        domain = \"\"\n\n        if normalized_url and \" \" not in normalized_url:\n            parts = normalized_url.split(\"://\", 1)\n\n            if len(parts) == 2:\n                protocol = parts[0].lower()\n                host_part = parts[1].split(\"/\", 1)[0].split(\"?\", 1)[0].split(\"#\", 1)[0]\n                host = host_part.split(\":\", 1)[0]\n\n                if protocol in (\"http\", \"https\") and host and \".\" in host:\n                    is_valid = True\n                    domain = host.lower()\n\n        if is_valid:\n            valid_urls.append({\n                \"attribute_id\": url_number,\n                \"url\": normalized_url,\n                \"domain\": domain\n            })\n            url_number += 1\n\n    return {\n        \"urls\": valid_urls,\n        \"url_count\": len(valid_urls)\n    }",
        "requirements": "requests==2.34.2",
        "timeout": "10",
        "input": {
          "urls": "<<webhook.body.urls>>"
        }
      },
      "reporting": {
        "time_saved_value": 0,
        "time_saved_unit": "minutes"
      },
      "monitoring": {
        "monitor_all_events": false,
        "monitor_failures": true,
        "monitor_no_events_emitted": null
      },
