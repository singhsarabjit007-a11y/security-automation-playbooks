  "diagram_notes": [
    {
      "content": "Combines the URLScan and VirusTotal findings into a clear, concise risk assessment and investigation summary.\n",
      "position": [
        1140,
        900
      ],
      "guid": "dfff02dc45dc4fabe996bc85f5bc5c3c",
      "width": 290
    },
    {
      "content": "Tested Placeholder\\\nEmail sent with RAW data from URLScan results and VT. Along with summary from AI\n",
      "position": [
        660,
        1140
      ],
      "guid": "438c3979af7f6d719777d6a6502f4837",
      "width": 290
    },
    {
      "content": "Tested Placeholder\\\nScreenshot sent over at slack\\\nTested Slack functionality\n",
      "position": [
        330,
        945
      ],
      "guid": "a00483c28db8d8cb3a454e127a1daad3",
      "width": 290
    },
    {
      "content": "Normalizes submitted URLs by converting defanged formats (for example, `hxxps://site[.]com`) into standard URLs. Invalid URLs are excluded; valid URLs receive an ID and extracted domain.\n",
      "position": [
        1080,
        180
      ],
      "guid": "93c069f5a05102bc8670afc7cf304976",
      "width": 796
    },
    {
      "content": "Splits the normalized URL list into separate events, so each URL can be enriched and analyzed independently.\n",
      "position": [
        1080,
        270
      ],
      "guid": "0aa4b159b7a01705a733e02dcd530bdf",
      "width": 793
    },
    {
      "content": "Submits each URL to URLScan.io, waits for analysis to finish, and extracts scan details such as redirects, hosting, IPs, TLS data, links, and a screenshot.\n",
      "position": [
        315,
        240
      ],
      "guid": "707c97bdb82bc7f94cee1cb8aa8b4a4c",
      "width": 290
    },
    {
      "content": "Tests the URL against additional OSINT services through HTTP requests and collects the returned enrichment data for further analysis.\n",
      "position": [
        1455,
        390
      ],
      "guid": "13e10a52ee40b6ffa5b9546b3d6f467c",
      "width": 290
    },
    {
      "content": "Submits each URL to VirusTotal, retrieves the analysis results, and extracts the detection count, verdict, severity, threat score, categories, and description.\n",
      "position": [
        1095,
        645
      ],
      "guid": "7fff71a363575b71ac088f09f1bf2651",
      "width": 290
    },
    {
      "content": "**DISCLAIMER**\\\nThe story is not production ready. This was created to test OSINT sources and incorporate AI agent for end summary. This also tested integration with emails and slack. \n",
      "position": [
        511,
        -54
      ],
      "guid": "a10445057e883942815b59d87abfc7ee",
      "width": 960
    }
  ],
